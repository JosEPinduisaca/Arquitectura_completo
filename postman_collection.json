{
  "info": {
    "name": "Students API - CRUD completo",
    "description": "Colección con los 16 endpoints CRUD para Student, Professor, Subject y Enrollment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8787" }
  ],
  "item": [
    {
      "name": "Student",
      "item": [
        {
          "name": "Crear estudiante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"ana@puce.edu.ec\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
          }
        },
        {
          "name": "Listar estudiantes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
          }
        },
        {
          "name": "Obtener estudiante por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
          }
        },
        {
          "name": "Actualizar estudiante",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres Ruiz\",\n  \"email\": \"ana.torres@puce.edu.ec\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
          }
        },
        {
          "name": "Eliminar estudiante",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
          }
        }
      ]
    },
